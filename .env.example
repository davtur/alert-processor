# Copy to .env and fill in. Never commit .env.
# Local run: set -a && source .env && set +a

# Required for recommendations. Without it, alerts are stored as acknowledge.
XAI_API_KEY=
XAI_MODEL=grok-4-1-fast-non-reasoning
# XAI_API_URL=https://api.x.ai/v1/chat/completions

# Required for the local inbox password. Also used as the signing secret if SIGNING_SECRET is unset.
AUTH_PASSWORD=
# Required before this service is reachable by anyone else. Use a long random value.
SIGNING_SECRET=

# Public URL written into email links and the secure-cookie flag. No trailing path.
PUBLIC_BASE_URL=http://127.0.0.1:8080

# Optional label shown in the inbox header and in the model prompt.
CLUSTER_NAME=

# SQLite directory when DATABASE_URL is empty. Use PostgreSQL for more than one replica.
DATA_DIR=./data
# DATABASE_URL=postgresql://alert-processor:password@postgres:5432/alert-processor

# Shared secret Alertmanager sends as "Authorization: Bearer <token>".
# Leave empty only when /api/v1/webhook is unreachable from outside the cluster.
WEBHOOK_TOKEN=

# GitOps pull requests. Token needs contents and pull-request access on that repo. Nothing is auto-merged.
GITHUB_TOKEN=
GITHUB_REPO=owner/gitops-repo
# Comma-separated path prefixes the model may propose. The fallback proposal directory must sit under one of them.
GITOPS_PATH_PREFIXES=apps-kustomize,cluster-kustomize,operator-subscriptions,apps-argo,gitops-oai
GITOPS_PROPOSAL_PREFIX=apps-kustomize/alert-processor/proposals

# Email. All three of SMTP_USER, SMTP_PASSWORD, and MAIL_TO are required or mail is skipped.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_TO=
MAIL_FROM=

# Set when the inbox sits behind OpenShift oauth-proxy (or another proxy that sets X-Forwarded-User).
# OAUTH_LOGOUT_URL=https://oauth-openshift.apps.example.com/logout?then=https://alert-processor.apps.example.com
# OAUTH_COOKIE_NAME=_oauth_proxy_ap
